body{
    background-color: #1C1B20;
    color: white;
    margin: 0;
}

header{
    display: flex;
    justify-content: space-between ;
    padding:0 20px ;
    align-items: center;
    background-color: black;

}
.danh-sach-muc{
    list-style: none;
    display:flex;
    gap:10px;
    padding: 0%;
}

.lien-ket-muc{
    text-decoration: none;
    color:#ffffff;
}

.dang-chon{
    background-color:gray;
}

.muc{
    padding: 10px 20px;
    border-radius: 20px;
}

.logo{
    width: 5%
}

.avatar{
    width: 40px;
    border-radius: 20px;
}

.muc:hover{
    background-color: grey;
}

.banner{
    width: 90%;
   /* background-color: red; */
    margin: 20px auto;
}


.banner-img{
    width: 100%;
    border-radius: 20px;
}

.video{
            width: 100%;
            height: 500px;
            background-color: white;
            border-radius: 20px;
}

.the-loai{
    width:90%;
    height: 20vh;

    margin: 10px auto;
}

.danh-sach-phim{
    display: flex;
    justify-content: space-between;
}

.phim{
    width:19%;
    height: 20vh;

}

img{
    width: 100%;
    border-radius: 20px;
}

.phim-chan{
    width:19%;
    height: 50vh;

}

.danh-sach-phim-chan{
    display: flex;
    justify-content: space-between;
}

.phim-chan img {
    border-radius: 50%;
    width: 120px;
    height: 120px;
}

.lien-ket-chan-trang {
    width: 80%;
    margin: 50px auto;

    display: flex;
    flex-wrap: wrap;
}

.lien-ket-chan-trang a {
    width: 33%;
    color: #888;
    font-size: 13px;
    text-decoration: none;
    margin-bottom: 20px;
}
